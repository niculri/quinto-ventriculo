#!/bin/sh
# Before every push: the forbidden-patterns check and the fast part of the CI (the end to end tests run only there).
# Turned on by .githooks/install.sh; in an emergency, `git push --no-verify` skips it.

# A CI that pushes would run it twice.
if [ -n "$CI" ] || [ -n "$GITHUB_ACTIONS" ]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

if ! command -v npm >/dev/null 2>&1 || ! command -v node >/dev/null 2>&1; then
  echo "pre-push: no encuentro npm en el PATH de este git, así que no puedo correr las pruebas." >&2
  echo "  Haz el push desde una terminal con Node (o, solo en una emergencia, git push --no-verify)." >&2
  exit 1
fi

# With qv.requirePrivate, a missing private repository fails the real-material checks instead of skipping them.
if [ "$(git config --bool --get qv.requirePrivate 2>/dev/null)" = "true" ]; then
  export QV_REQUIRE_PRIVATE=1
fi

# Every commit of the push (refs on the standard input) against the private repository's forbidden patterns, if any.
node .githooks/forbidden.mjs "$1" || exit 1

echo "pre-push: tipos, lint, supresiones, ciclos, nombres de pruebas, código sin uso, formato y Vitest (en una emergencia, git push --no-verify lo salta)…"
fail() {
  echo "" >&2
  echo "pre-push: falló «$1». El push se canceló: arréglalo y vuelve a hacer push." >&2
  exit 1
}
npm run --silent typecheck || fail "npm run typecheck"
npm run --silent lint || fail "npm run lint"
npm run --silent suppressions || fail "npm run suppressions (las supresiones de ESLint subieron)"
npm run --silent deps || fail "npm run deps (un ciclo de imports nuevo)"
npm run --silent test-names || fail "npm run test-names (una prueba que no sigue la regla de nombres)"
npm run --silent knip || fail "npm run knip (archivos, exports o dependencias sin uso)"
npm run --silent format:check || fail "npm run format:check"
npm test --silent || fail "npm test (Vitest)"
echo "pre-push: todo en orden."
