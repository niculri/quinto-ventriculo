# What git never tracks: build output, local settings and secrets, and what belongs to the private repository.
node_modules/
dist/
# wrangler deploy --dry-run --outdir dist-worker (the CI's check of the Worker)
dist-worker/
*.tsbuildinfo
.wrangler/
.dev.vars
.env
.env.*
!.env.example
coverage/
playwright-report/
test-results/
# Importer output in dry-run mode (copyrighted content: never in the repo)
.output/
# Importer cache of the converted images
.cache/
.DS_Store
# MCP settings of Claude Code: they may carry a token
.mcp.json
**/.claude/settings.local.json
CLAUDE.local.md
.claude/specs/
.claude/history/
# Safety net: what belongs to the private repository never goes in here, even if it is written in this folder.
# Remove a line only to publish something on purpose.
/content/
/docs/
/tests/
/.claude/*
!/.claude/settings.json
