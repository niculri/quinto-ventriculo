// One Worker serves the web (apps/web/dist) and the API (/api/*) on the same domain. Secrets go with
// `wrangler secret put`: CONTENT_SERVICE_ROLE_KEY, MEDIA_SECRET, CF_ACCOUNT_ID, CF_ANALYTICS_TOKEN.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "quinto-ventriculo",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // A Cloudflare Redirect Rule sends the bare domain to www before it reaches the Worker.
  "routes": [
    { "pattern": "www.quintoventriculo.cl", "custom_domain": true },
    { "pattern": "quintoventriculo.cl", "custom_domain": true },
  ],
  "workers_dev": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "quinto-ventriculo-media" },
    // It has to exist before deploying, with its lifecycle and lock rules.
    { "binding": "BACKUPS", "bucket_name": "quinto-ventriculo-backups" },
  ],
  "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "qv_usage" }],
  "vars": {
    "USERS_SUPABASE_URL": "https://nepxecanupunoezfblon.supabase.co",
    "CONTENT_SUPABASE_URL": "https://digqrtjqzdqlgjscnznj.supabase.co",
    // Not secret (the web has it too), and here rather than in Cloudflare's panel: a deploy replaces the panel's vars.
    "USERS_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_aoi84HOhmVNxCV6KWt1-JQ_hXe4strw",
  },
  // Without `issues` here, a deploy would turn Workers Issues off.
  "observability": { "enabled": true, "issues": { "enabled": true } },
}
