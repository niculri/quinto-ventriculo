# USERS Supabase project (Project Settings → API). The publishable key is public by design:
# what protects the data are the database's RLS policies.
VITE_USERS_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_USERS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Google Cloud → the OAuth web client's ID («….apps.googleusercontent.com»), public like the publishable key. With it,
# the landing page uses Google's own button and the sign-in window shows the site's domain; without it, the redirect.
VITE_GOOGLE_CLIENT_ID=
