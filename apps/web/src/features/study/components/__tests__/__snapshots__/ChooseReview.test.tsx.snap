exports[`choosing a final review > counts one card in the singular 1`] = `"<div><h1>Repaso final de Certamen 1</h1><p>Este repaso no cambia las fechas de tus tarjetas.</p><div><button type="button"><span><span>Todo lo visto</span><span>1 tarjeta</span></span><span>Parte por lo que estás más cerca de olvidar.</span></button><button type="button"><span><span>Solo lo marcado y lo difícil</span><span>1 tarjeta</span></span><span>Las que marcaste para revisar y las que has fallado varias veces.</span></button></div></div>"`;

exports[`choosing a final review > offers everything seen and the hard ones, and an empty option does not work 1`] = `"<div><h1>Repaso final de Certamen 1</h1><p>Este repaso no cambia las fechas de tus tarjetas.</p><div><button type="button"><span><span>Todo lo visto</span><span>2 tarjetas</span></span><span>Parte por lo que estás más cerca de olvidar.</span></button><button type="button" disabled=""><span><span>Solo lo marcado y lo difícil</span><span>0 tarjetas</span></span><span>Las que marcaste para revisar y las que has fallado varias veces.</span></button></div></div>"`;

exports[`choosing a final review > with nothing seen, says so and goes back 1`] = `"<div><h1>Repaso final de Certamen 1</h1><p>Todavía no has visto tarjetas de este certamen. Cuando estudies algunas, podrás repasarlas aquí.</p><a href="/semesters/1/courses/anatomia-1/anki/certamen-1">Volver a Certamen 1</a></div>"`;
