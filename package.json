{
  "name": "el-quinto-ventriculo",
  "private": true,
  "description": "El Quinto Ventrículo — el ventrículo que no aparece en el Netter",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "db"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "npm run dev -w @qv/web",
    "dev:demo": "npm run dev:demo -w @qv/web",
    "dev:local": "npm run dev:local -w @qv/web",
    "build": "npm run build -w @qv/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "suppressions": "tsx packages/ops/src/suppressionsCli.ts",
    "deps": "tsx packages/ops/src/cyclesCli.ts",
    "deps:baseline": "tsx packages/ops/src/cyclesCli.ts --write-baseline",
    "test-names": "tsx packages/ops/src/testNamesCli.ts",
    "knip": "knip",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "coverage": "QV_COVERAGE=1 vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "npm run e2e -w @qv/web",
    "import": "npm run import -w @qv/importer --",
    "unpublish": "npm run unpublish -w @qv/importer --",
    "db:types": "tsx db/scripts/dbTypes.ts",
    "db:schema": "tsx db/scripts/schemaSnapshot.ts",
    "db:schema:compare": "tsx db/scripts/schemaCompare.ts",
    "check": "npm run typecheck && npm run lint && npm run suppressions && npm run deps && npm run test-names && npm run knip && npm run format:check && npm test",
    "deploy": "tsx packages/ops/src/deployCli.ts",
    "smoke": "tsx packages/ops/src/smokeCli.ts",
    "prepare": "sh .githooks/install.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@qv/eslint-plugin": "0.0.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.15.0",
    "eslint-plugin-boundaries": "7.4.3",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "knip": "6.45.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "eslint-plugin-sonarjs": {
      "minimatch": "11.0.9"
    }
  }
}
